# Public site URL used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Headless CMS (optional). When SANITY_PROJECT_ID is empty the site uses the
# bundled local content in src/lib/cms/local so it runs without credentials.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19
# Read token is only needed for private datasets or draft previews.
SANITY_API_READ_TOKEN=
# Shared secret used by the CMS webhook to trigger on-demand revalidation.
SANITY_REVALIDATE_SECRET=

# Inquiry delivery (optional). When empty, inquiries are validated and logged.
INQUIRY_WEBHOOK_URL=
